{
  "name": "@bakeoff.pompy.uk/common",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch src --watch tsconfig.json",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
